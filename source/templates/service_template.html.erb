---
---

<% utf8 = ->(value) { value.to_s.dup.force_encoding("UTF-8") } %>

<h1 id="service"><%= utf8.call(service_name) %></h1>

<p>Repository: <%= link_to(utf8.call(repo_name), "https://github.com/#{utf8.call(repo_name)}") %></p>

<% if ruby_service_profile %>

<h2 id="tech-stack">Tech stack</h2>

<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>Service name</th>
        <th>repo</th>
        <th>rails</th>
        <th>ruby</th>
        <th>dfe-analytics</th>
        <th>dfe-reference-data</th>
        <th>dfe-autocomplete</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><%= utf8.call(ruby_service_profile.service_name) %></td>
        <td><%= link_to(utf8.call(ruby_service_profile.repo_name), "https://github.com/#{utf8.call(ruby_service_profile.repo_name)}") %></td>
        <td><%= utf8.call(ruby_service_profile.rails) %></td>
        <td><%= utf8.call(ruby_service_profile.ruby) %></td>
        <td><%= utf8.call(ruby_service_profile.dfe_analytics) %></td>
        <td><%= utf8.call(ruby_service_profile.dfe_reference_data) %></td>
        <td><%= utf8.call(ruby_service_profile.dfe_autocomplete) %></td>
      </tr>
    </tbody>
  </table>
</div>
<% end %>

<% if pages.any? %>

<h2 id="documentation-pages">Documentation pages</h2>

<ul class="govuk-list">
<% pages.sort_by { |page| utf8.call(page.fetch(:title)) }.each do |page| %>
  <li><%= link_to(utf8.call(page.fetch(:title)), "/#{page.fetch(:path)}") %></li>
<% end %>
</ul>
<% else %>
<p>No documentation pages are currently available for this service.</p>
<% end %>
