---
---

<h1><%= service_name.to_s.force_encoding("UTF-8") %></h1>

<p>Repository: <%= link_to(repo_name.to_s.force_encoding("UTF-8"), "https://github.com/#{repo_name.to_s.force_encoding("UTF-8")}") %></p>

<% if pages.any? %>

<h2>Documentation pages</h2>

<ul class="govuk-list">
<% pages.sort_by { |page| page.fetch(:title).to_s.force_encoding("UTF-8") }.each do |page| %>
  <li><%= link_to(page.fetch(:title).to_s.force_encoding("UTF-8"), "/#{page.fetch(:path)}") %></li>
<% end %>
</ul>
<% else %>
<p>No documentation pages are currently available for this service.</p>
<% end %>
